    },
    {
      "name": "HlBook.setLevel",
      "kind": "definition",
      "type": "Option (Nat × Nat) → Nat → Nat → Option (Nat × Nat)",
      "typeHash": "7d346475679b42104d49b98824630ca7699df2ec0a0c9f76eebfa0541fd49746",
      "valueHash": "fd6ef27f7c6e5693dec88cbe1ab151e7408a36e06274b154e42971021d4ba947"
    },
    {
      "name": "HlBook.setLevel_at",
      "kind": "theorem",
      "type": "∀ (b b' : List HlBook.Order) (k : HlBook.Key) (old new : Nat) (x : Option (Nat × Nat)), HlBook.At b x k → HlBook.cnt k b ≠ 0 → old ≤ HlBook.tot k b → HlBook.tot k b' + old = HlBook.tot k b + new → HlBook.cnt k b' = HlBook.cnt k b → HlBook.At b' (HlBook.setLevel x old new) k",
      "typeHash": "a8fac09827949920181c7c79074f8b770f8cac08ed6bc188de626383191b0ad6",
      "valueHash": null
    },
    {
      "name": "HlBook.setSz",
