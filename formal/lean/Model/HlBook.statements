      "type": "∀ (i : Nat) (o : HlBook.Order) (b b' : List HlBook.Order) (v v' : HlBook.View), i ≤ b.length → HlBook.Inv b v → HlBook.restAt i o b v = some (b', v') → HlBook.Inv b' v'",
      "typeHash": "d475c342794d76cc7e706849befd53abc38de48d8435e10725217f114d2402b8",
      "valueHash": null
    },
