    {
      "name": "HlBook.subLevel",
      "kind": "definition",
      "type": "Option (Nat × Nat) → Nat → Option (Nat × Nat)",
      "typeHash": "07176ed1ce42d0f6a9c3514260e4df4735d74a720bba4dc7f677e88465e1fbf4",
      "valueHash": "0224a185b4b9594acb313ac050ccf167b84829b218133bdade944f8031a0dec1"
    },
    {
      "name": "HlBook.subLevel_at",
      "kind": "theorem",
      "type": "∀ (b b' : List HlBook.Order) (k : HlBook.Key) (sz : Nat) (x : Option (Nat × Nat)), HlBook.At b x k → HlBook.tot k b = HlBook.tot k b' + sz → HlBook.cnt k b = HlBook.cnt k b' + 1 → HlBook.At b' (HlBook.subLevel x sz) k",
      "typeHash": "9b553cbd6cfcd69d19bb52892c9bf2c7654bf66fe8c52d1471d84fc35f48c24d",
      "valueHash": null
    },
    {
      "name": "HlBook.take",
      "kind": "definition",
      "type": "Nat → List HlBook.Order → Option (HlBook.Order × List HlBook.Order)",
      "typeHash": "fc49eb2e14caf8870639db102edc52ba87240af47e61db7cf9f5a41d718bb770",
      "valueHash": "2cbd4d768c02c8f42f9d51b73961797da9be59060f50a9780f04060cb552d9e9"
    },
    {
      "name": "HlBook.take_spec",
      "kind": "theorem",
      "type": "∀ (k : HlBook.Key) (oid : Nat) (b r : List HlBook.Order) (o : HlBook.Order), HlBook.take oid b = some (o, r) → (HlBook.tot k b = HlBook.tot k r + if o.key = k then o.sz else 0) ∧ (HlBook.cnt k b = HlBook.cnt k r + if o.key = k then 1 else 0) ∧ (∀ (sz : Nat), (HlBook.tot k (HlBook.setSz oid sz b) + if o.key = k then o.sz else 0) = HlBook.tot k b + if o.key = k then sz else 0) ∧ ∀ (sz : Nat), HlBook.cnt k (HlBook.setSz oid sz b) = HlBook.cnt k b",
      "typeHash": "08fef3650b2ac8153c954df7455812791ebedbae58e961f8f3336e2e9adf5c76",
      "valueHash": null
    },
    {
      "name": "HlBook.tot",
      "kind": "definition",
      "type": "HlBook.Key → List HlBook.Order → Nat",
      "typeHash": "c6b850889fa6dfce8e5601ec811e1066055809b623886b9925274a7159e449c4",
      "valueHash": "73dce16b327950d230d711663a54262b8ceee764e76968a46c7a8b4719ac00d4"
    },
    {
      "name": "HlBook.tot_append",
      "kind": "theorem",
      "type": "∀ (k : HlBook.Key) (a c : List HlBook.Order), HlBook.tot k (a ++ c) = HlBook.tot k a + HlBook.tot k c",
      "typeHash": "f7637c24f7c41fe040499dd9ff0d8d85f57141815e1dc56b15b3eb553bdc97fb",
      "valueHash": null
    },
    {
      "name": "HlBook.tot_insertIdx",
      "kind": "theorem",
      "type": "∀ (k : HlBook.Key) (i : Nat) (o : HlBook.Order) (b : List HlBook.Order), i ≤ b.length → HlBook.tot k (b.insertIdx i o) = HlBook.tot k b + if o.key = k then o.sz else 0",
      "typeHash": "e3b2cacf14ba384b170953a6f6be404a4ad1896f8ba5bc2bd9bdf5db8ee058b2",
      "valueHash": null
    },
